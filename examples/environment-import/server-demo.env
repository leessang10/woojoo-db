# Woojoo local development server — fake credentials for import testing only.
# Use {{baseUrl}} in a request URL and {{accessToken}} for bearer authentication.
APP_NAME=woojoo-api
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
baseUrl=http://localhost:8080/api/v1
accessToken=demo-token-not-a-real-access-token

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=woojoo_dev
DB_USER=woojoo_app
DB_PASSWORD="demo-only#password=123!"
DATABASE_URL="postgresql://woojoo_app:demo-password@localhost:5432/woojoo_dev?sslmode=disable&connect_timeout=10"
DB_POOL_MAX=20

# Redis / authentication
REDIS_URL=redis://localhost:6379/0
JWT_SECRET="demo-only-jwt-secret-do-not-use-in-production"
JWT_EXPIRES_IN=1h
SESSION_TTL_SECONDS=86400

# HTTP / logging / uploads
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
LOG_LEVEL=debug
LOG_JSON=true
REQUEST_TIMEOUT_MS=30000
UPLOAD_MAX_MB=25
S3_BUCKET=woojoo-local-uploads
S3_REGION=ap-northeast-2
SENTRY_DSN=
WELCOME_MESSAGE="Welcome to Woojoo API # local development"
