{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Woojoo",
  "version": "0.1.0",
  "identifier": "app.woojoo.db",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Woojoo — Database workspace",
      "width": 1440, "height": 940, "minWidth": 960, "minHeight": 640,
      "backgroundColor": "#141720"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
